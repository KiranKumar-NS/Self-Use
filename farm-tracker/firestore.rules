rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isManagerOrAdmin() {
      return isAuthenticated() && (getUserRole() == 'admin' || getUserRole() == 'manager');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return getUserData().isActive == true;
    }

    function isActiveReader() {
      return isAuthenticated() && isActiveUser();
    }

    function hasSegmentAccess(segment) {
      return isAdmin() ||
        (getUserRole() == 'manager' && segment in getUserData().assignedSegments);
    }

    // 'personal' is a shared pseudo-segment writable by any active manager
    function hasSegmentOrPersonalAccess(segment) {
      return segment == 'personal' || hasSegmentAccess(segment);
    }

    // Post-write state must keep timeline bounded (client caps at 100, which
    // this backstop matches; ~100 entries stays well under the 1 MiB doc limit)
    function timelineWithinCap() {
      return !('timeline' in request.resource.data)
        || request.resource.data.timeline.size() <= 100;
    }

    // Users collection
    match /users/{userId} {
      // Self-read must work even for deactivated users (login flow reads the
      // profile to detect isActive and sign the user out)
      allow read: if isAuthenticated() && (request.auth.uid == userId || isActiveUser());
      // User can update their own profile (but NOT role, segments, or isActive)
      allow update: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.assignedSegments == resource.data.assignedSegments
        && request.resource.data.isActive == resource.data.isActive;
      // Admin can create/update/delete any user
      allow create, update, delete: if isAdmin();
    }

    // Segments (reference data)
    match /segments/{segmentId} {
      allow read: if isActiveReader();
      allow write: if isManagerOrAdmin() && isActiveUser();
    }

    // Categories (reference data)
    match /categories/{categoryId} {
      allow read: if isActiveReader();
      allow write: if isAdmin();
    }

    // App metadata (tag/product suggestion lists, small shared config docs)
    match /meta/{docId} {
      allow read: if isActiveReader();
      allow write: if isManagerOrAdmin() && isActiveUser();
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read: if isActiveReader();
      allow create: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentOrPersonalAccess(request.resource.data.segment)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.isDeleted == false
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.type in ['expense', 'income']
        && request.resource.data.month is string
        && request.resource.data.year is int
        && timelineWithinCap();
      allow update: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentOrPersonalAccess(resource.data.segment)
        && hasSegmentOrPersonalAccess(request.resource.data.segment)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.type in ['expense', 'income']
        && timelineWithinCap();
      allow delete: if isAdmin();
    }

    // Loans (personal loans use segment='personal' which all managers can access)
    match /loans/{loanId} {
      allow read: if isActiveReader();
      allow create: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentOrPersonalAccess(request.resource.data.segment)
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && timelineWithinCap();
      allow update: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentOrPersonalAccess(resource.data.segment)
        && timelineWithinCap();
      allow delete: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentOrPersonalAccess(resource.data.segment);

      // Repayments subcollection — check parent loan segment
      match /repayments/{repaymentId} {
        allow read: if isActiveReader();
        allow create: if isManagerOrAdmin() && isActiveUser()
          && hasSegmentOrPersonalAccess(get(/databases/$(database)/documents/loans/$(loanId)).data.segment);
        allow update, delete: if isManagerOrAdmin() && isActiveUser()
          && hasSegmentOrPersonalAccess(get(/databases/$(database)/documents/loans/$(loanId)).data.segment);
      }
    }

    // Monthly summaries — client-maintained aggregation counters.
    // Doc ID must match the identity fields so a manager cannot corrupt another
    // period/segment's counters; money fields must be numbers when present
    // (merge writes with increments omit fields they don't touch).
    match /monthlySummaries/{summaryId} {
      allow read: if isActiveReader();
      allow create, update: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentOrPersonalAccess(request.resource.data.segment)
        && summaryId == request.resource.data.month + '-' + request.resource.data.segment
        && (!('totalIncome' in request.resource.data) || request.resource.data.totalIncome is number)
        && (!('totalExpense' in request.resource.data) || request.resource.data.totalExpense is number)
        && (!('netProfit' in request.resource.data) || request.resource.data.netProfit is number);
      // Only the admin reconciliation tool removes orphaned summaries
      allow delete: if isAdmin();
    }

    // Yearly summaries — same contract as monthly
    match /yearlySummaries/{summaryId} {
      allow read: if isActiveReader();
      allow create, update: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentOrPersonalAccess(request.resource.data.segment)
        && summaryId == string(request.resource.data.year) + '-' + request.resource.data.segment
        && (!('totalIncome' in request.resource.data) || request.resource.data.totalIncome is number)
        && (!('totalExpense' in request.resource.data) || request.resource.data.totalExpense is number)
        && (!('netProfit' in request.resource.data) || request.resource.data.netProfit is number);
      allow delete: if isAdmin();
    }

    // Inventory events
    match /inventoryEvents/{eventId} {
      allow read: if isActiveReader();
      allow create: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentAccess(request.resource.data.segment);
      allow update: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentAccess(resource.data.segment);
      allow delete: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentAccess(resource.data.segment);
    }

    // Tasks - managers/admins can write, all active users can read
    match /tasks/{taskId} {
      allow read: if isActiveReader();
      allow create, update, delete: if isManagerOrAdmin() && isActiveUser();
    }

    // Animals
    match /animals/{animalId} {
      allow read: if isActiveReader();
      allow create: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentAccess(request.resource.data.segment);
      allow update: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentAccess(resource.data.segment);
      allow delete: if isAdmin();
    }

    // Buyers
    match /buyers/{buyerId} {
      allow read: if isActiveReader();
      allow create, update: if isManagerOrAdmin() && isActiveUser();
      allow delete: if isAdmin();
    }

    // Schedules (recurring transactions + reminders)
    match /schedules/{scheduleId} {
      allow read: if isActiveReader();
      allow create, update: if isManagerOrAdmin() && isActiveUser();
      allow delete: if isAdmin();
    }

    // Breeding records
    match /breedingRecords/{recordId} {
      allow read: if isActiveReader();
      allow create: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentAccess(request.resource.data.segment);
      allow update: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentAccess(resource.data.segment);
      allow delete: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentAccess(resource.data.segment);
    }

    // Crop activities
    match /cropActivities/{activityId} {
      allow read: if isActiveReader();
      allow create: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentAccess(request.resource.data.segment);
      allow update: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentAccess(resource.data.segment);
      allow delete: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentAccess(resource.data.segment);
    }

    // Harvests
    match /harvests/{harvestId} {
      allow read: if isActiveReader();
      allow create: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentAccess(request.resource.data.segment);
      allow update: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentAccess(resource.data.segment);
      allow delete: if isManagerOrAdmin() && isActiveUser()
        && hasSegmentAccess(resource.data.segment);
    }

    // Inventory items (consumables)
    match /inventoryItems/{itemId} {
      allow read: if isActiveReader();
      allow create, update: if isManagerOrAdmin() && isActiveUser();
      allow delete: if isAdmin();
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if isActiveReader();
      allow create, update: if isManagerOrAdmin() && isActiveUser();
      allow delete: if isAdmin();
    }
  }
}
