rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isManagerOrAdmin() {
      return isAuthenticated() && (getUserRole() == 'admin' || getUserRole() == 'manager');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasSegmentAccess(segment) {
      return isAdmin() ||
        (getUserRole() == 'manager' && segment in getUserData().assignedSegments);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // User can create/update their own profile
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      // Admin can create/update/delete any user
      allow create, update, delete: if isAdmin();
    }

    // Segments (reference data)
    match /segments/{segmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Categories (reference data)
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isManagerOrAdmin()
        && hasSegmentAccess(request.resource.data.segment)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.isDeleted == false;
      allow update: if isManagerOrAdmin()
        && hasSegmentAccess(resource.data.segment);
      allow delete: if isAdmin();
    }

    // Loans (personal loans use segment='personal' which all users can access)
    match /loans/{loanId} {
      allow read: if isAuthenticated();
      allow create: if isManagerOrAdmin()
        && (request.resource.data.segment == 'personal' || hasSegmentAccess(request.resource.data.segment));
      allow update: if isManagerOrAdmin()
        && (resource.data.segment == 'personal' || hasSegmentAccess(resource.data.segment));
      allow delete: if isAdmin();

      // Repayments subcollection
      match /repayments/{repaymentId} {
        allow read: if isAuthenticated();
        allow create: if isManagerOrAdmin();
        allow update, delete: if isAdmin();
      }
    }

    // Monthly summaries
    match /monthlySummaries/{summaryId} {
      allow read: if isAuthenticated();
      allow write: if isManagerOrAdmin();
    }

    // Tasks - all authenticated users can manage
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }
  }
}
