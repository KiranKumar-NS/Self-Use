rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isManagerOrAdmin() {
      return isAuthenticated() && (getUserRole() == 'admin' || getUserRole() == 'manager');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasSegmentAccess(segment) {
      return isAdmin() ||
        (getUserRole() == 'manager' && segment in getUserData().assignedSegments);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // User can update their own profile (but NOT role, segments, or isActive)
      allow update: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.assignedSegments == resource.data.assignedSegments
        && request.resource.data.isActive == resource.data.isActive;
      // Admin can create/update/delete any user
      allow create, update, delete: if isAdmin();
    }

    // Segments (reference data)
    match /segments/{segmentId} {
      allow read: if isAuthenticated();
      allow write: if isManagerOrAdmin();
    }

    // Categories (reference data)
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isManagerOrAdmin()
        && hasSegmentAccess(request.resource.data.segment)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.isDeleted == false;
      allow update: if isManagerOrAdmin()
        && hasSegmentAccess(resource.data.segment);
      allow delete: if isAdmin();
    }

    // Loans (personal loans use segment='personal' which all users can access)
    match /loans/{loanId} {
      allow read: if isAuthenticated();
      allow create: if isManagerOrAdmin()
        && (request.resource.data.segment == 'personal' || hasSegmentAccess(request.resource.data.segment));
      allow update: if isManagerOrAdmin()
        && (resource.data.segment == 'personal' || hasSegmentAccess(resource.data.segment));
      allow delete: if isManagerOrAdmin();

      // Repayments subcollection
      match /repayments/{repaymentId} {
        allow read: if isAuthenticated();
        allow create: if isManagerOrAdmin();
        allow update, delete: if isManagerOrAdmin();
      }
    }

    // Monthly summaries
    match /monthlySummaries/{summaryId} {
      allow read: if isAuthenticated();
      allow write: if isManagerOrAdmin();
    }

    // Inventory events
    match /inventoryEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isManagerOrAdmin()
        && hasSegmentAccess(request.resource.data.segment);
      allow update, delete: if isManagerOrAdmin();
    }

    // Tasks - managers/admins can write, all authenticated can read
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isManagerOrAdmin();
    }

    // Yearly summaries
    match /yearlySummaries/{summaryId} {
      allow read: if isAuthenticated();
      allow write: if isManagerOrAdmin();
    }

    // Animals
    match /animals/{animalId} {
      allow read: if isAuthenticated();
      allow create: if isManagerOrAdmin()
        && hasSegmentAccess(request.resource.data.segment);
      allow update: if isManagerOrAdmin();
      allow delete: if isAdmin();
    }

    // Buyers
    match /buyers/{buyerId} {
      allow read: if isAuthenticated();
      allow create, update: if isManagerOrAdmin();
      allow delete: if isAdmin();
    }

    // Schedules (recurring transactions + reminders)
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow create, update: if isManagerOrAdmin();
      allow delete: if isAdmin();
    }

    // Breeding records
    match /breedingRecords/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isManagerOrAdmin()
        && hasSegmentAccess(request.resource.data.segment);
      allow update, delete: if isManagerOrAdmin();
    }

    // Crop activities
    match /cropActivities/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isManagerOrAdmin()
        && hasSegmentAccess(request.resource.data.segment);
      allow update, delete: if isManagerOrAdmin();
    }

    // Harvests
    match /harvests/{harvestId} {
      allow read: if isAuthenticated();
      allow create: if isManagerOrAdmin()
        && hasSegmentAccess(request.resource.data.segment);
      allow update, delete: if isManagerOrAdmin();
    }

    // Inventory items (consumables)
    match /inventoryItems/{itemId} {
      allow read: if isAuthenticated();
      allow create, update: if isManagerOrAdmin();
      allow delete: if isAdmin();
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow create, update: if isManagerOrAdmin();
      allow delete: if isAdmin();
    }
  }
}
