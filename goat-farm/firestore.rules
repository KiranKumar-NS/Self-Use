rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToFarm(farmId) {
      return getUserData().farmId == farmId;
    }

    function hasRole(allowedRoles) {
      return getUserData().role in allowedRoles;
    }

    // Users collection
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || hasRole(['admin']));
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == uid || hasRole(['admin']));
      allow delete: if isAuthenticated() && hasRole(['admin']);
    }

    // Goats collection
    match /goats/{goatId} {
      allow read: if isAuthenticated() && belongsToFarm(resource.data.farmId);
      allow create: if isAuthenticated() && belongsToFarm(request.resource.data.farmId) && hasRole(['admin', 'manager']);
      allow update: if isAuthenticated() && belongsToFarm(resource.data.farmId) && hasRole(['admin', 'manager', 'worker']);
      allow delete: if isAuthenticated() && belongsToFarm(resource.data.farmId) && hasRole(['admin']);
    }

    // Breeding records
    match /breedingRecords/{recordId} {
      allow read: if isAuthenticated() && belongsToFarm(resource.data.farmId);
      allow create: if isAuthenticated() && belongsToFarm(request.resource.data.farmId) && hasRole(['admin', 'manager']);
      allow update: if isAuthenticated() && belongsToFarm(resource.data.farmId) && hasRole(['admin', 'manager']);
      allow delete: if isAuthenticated() && belongsToFarm(resource.data.farmId) && hasRole(['admin']);
    }

    // Feed logs
    match /feedLogs/{logId} {
      allow read: if isAuthenticated() && belongsToFarm(resource.data.farmId);
      allow create: if isAuthenticated() && belongsToFarm(request.resource.data.farmId);
      allow update: if isAuthenticated() && belongsToFarm(resource.data.farmId) && hasRole(['admin', 'manager']);
      allow delete: if isAuthenticated() && belongsToFarm(resource.data.farmId) && hasRole(['admin']);
    }

    // Feed stock
    match /feedStock/{stockId} {
      allow read: if isAuthenticated() && belongsToFarm(resource.data.farmId);
      allow create: if isAuthenticated() && belongsToFarm(request.resource.data.farmId) && hasRole(['admin', 'manager']);
      allow update: if isAuthenticated() && belongsToFarm(resource.data.farmId) && hasRole(['admin', 'manager']);
      allow delete: if isAuthenticated() && belongsToFarm(resource.data.farmId) && hasRole(['admin']);
    }

    // Milk yields
    match /milkYields/{yieldId} {
      allow read: if isAuthenticated() && belongsToFarm(resource.data.farmId);
      allow create: if isAuthenticated() && belongsToFarm(request.resource.data.farmId);
      allow update: if isAuthenticated() && belongsToFarm(resource.data.farmId) && hasRole(['admin', 'manager']);
      allow delete: if isAuthenticated() && belongsToFarm(resource.data.farmId) && hasRole(['admin']);
    }

    // Weight records
    match /weightRecords/{recordId} {
      allow read: if isAuthenticated() && belongsToFarm(resource.data.farmId);
      allow create: if isAuthenticated() && belongsToFarm(request.resource.data.farmId);
      allow update: if isAuthenticated() && belongsToFarm(resource.data.farmId) && hasRole(['admin', 'manager']);
      allow delete: if isAuthenticated() && belongsToFarm(resource.data.farmId) && hasRole(['admin']);
    }

    // Transactions
    match /transactions/{txnId} {
      allow read: if isAuthenticated() && belongsToFarm(resource.data.farmId) && hasRole(['admin', 'manager']);
      allow create: if isAuthenticated() && belongsToFarm(request.resource.data.farmId) && hasRole(['admin', 'manager']);
      allow update: if isAuthenticated() && belongsToFarm(resource.data.farmId) && hasRole(['admin', 'manager']);
      allow delete: if isAuthenticated() && belongsToFarm(resource.data.farmId) && hasRole(['admin']);
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && belongsToFarm(resource.data.farmId);
      allow create: if isAuthenticated() && belongsToFarm(request.resource.data.farmId);
      allow update: if isAuthenticated() && belongsToFarm(resource.data.farmId);
      allow delete: if isAuthenticated() && belongsToFarm(resource.data.farmId) && hasRole(['admin']);
    }
  }
}
